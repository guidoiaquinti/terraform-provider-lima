# Development override for local provider builds.
#
# Copy this to ~/.terraformrc (or ~/.tofurc for OpenTofu) and replace the path
# with the absolute path to the DIRECTORY containing the built binary, not the
# binary itself.
#
#   make build
#
# With a dev override in place, do not run `terraform init`; Terraform uses the
# local binary directly and prints a warning saying so.

provider_installation {
  dev_overrides {
    "example/lima" = "/absolute/path/to/terraform-provider-lima"
  }

  # Everything not overridden is still installed normally.
  direct {}
}
